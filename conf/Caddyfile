{
    servers {
        trusted_proxies static 10.88.0.0/8 127.0.0.1/32 172.18.0.1/32
    }
}

:80 {
    reverse_proxy /api/* http://api:3000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Port {server_port}
        header_up X-Forwarded-Proto {scheme}
    }

    reverse_proxy /* http://web:3000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Port {server_port}
        header_up X-Forwarded-Proto {scheme}
    }

    reverse_proxy /namepending-bucket/* http://storage:3900 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Port {server_port}
        header_up X-Forwarded-Proto {scheme}
    }
}

s3.localhost:80 {
    reverse_proxy /* http://storage:3900
}
